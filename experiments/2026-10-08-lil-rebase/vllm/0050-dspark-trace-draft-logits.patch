+                # kept, so it cannot see the trace; hand it the decision.
+                self.speculator.draft_trace_capture = (
+                    self._dspark_trace.next_step_taken
+                )
         sampler_output, num_sampled, num_rejected = self.sample(
             hidden_states, input_batch, grammar_output
         )
@@ -3789,6 +3797,13 @@ class GPUModelRunner(LoRAModelRunnerMixin):
                     else None
                 )
                 topk = getattr(self, "_dspark_logits_topk", None)
+                take_draft_topk = getattr(self.speculator, "take_draft_topk", None)
+                draft_topk = take_draft_topk() if take_draft_topk else None
+                draft_rows = draft_k = None
+                if draft_topk is not None:
+                    n_spec = self.speculator.num_speculative_steps
+                    draft_rows = input_batch.num_reqs * n_spec
+                    draft_k = int(draft_topk[0].shape[1])
                 self._dspark_trace.record(
                     input_batch.req_ids,
                     sampler_output.sampled_token_ids,
@@ -3800,6 +3815,14 @@ class GPUModelRunner(LoRAModelRunnerMixin):
                     num_tokens=rows,
                     logits_topk=topk[0] if topk is not None else None,
                     logits_cu=topk[1] if topk is not None else None,
+                    draft_topk=draft_topk,
+                    draft_rows=draft_rows,
+                    draft_k=draft_k,
+                    draft_n_spec=(
+                        self.speculator.num_speculative_steps
+                        if draft_topk is not None
+                        else None
+                    ),
                 )
         elif self.speculator is not None:
             draft_tokens_for_next_step = self.req_states.draft_tokens[
diff --git a/vllm/v1/worker/gpu/spec_decode/dspark/speculator.py b/vllm/v1/worker/gpu/spec_decode/dspark/speculator.py
