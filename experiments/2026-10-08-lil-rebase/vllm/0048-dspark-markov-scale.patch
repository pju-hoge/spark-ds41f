+++ b/vllm/v1/worker/gpu/spec_decode/dspark/speculator.py
@@ -23,6 +23,7 @@ CUDA graphs (FULL, mirroring DFlash) cover the whole draft step: the parallel
 backbone forward AND the sequential Markov sampling.
 """
 
+import os
 from collections.abc import Sequence
 from typing import Any
 
@@ -69,6 +70,69 @@ from vllm.v1.worker.gpu.spec_decode.dspark.utils import load_dspark_model
 
 logger = init_logger(__name__)
 
+# Runtime sweep knob for the Markov bias: one float, or one float per draft
+# position (comma- or newline-separated), read once at startup. Scaling the
+# Markov *embedding* scales the bias exactly — the head applies W2 to it
+# linearly — and works for every draft path, including the fused greedy
+# kernels that never materialise a bias tensor. A missing file keeps the
+# historical unscaled head, bit for bit.
+MARKOV_SCALE_PATH = os.environ.get(
+    "SPARK3_DSPARK_MARKOV_SCALE", "/cache/dspark-trace/MARKOV_SCALE"
+)
+
+
+def _load_markov_scale(path: str, num_steps: int) -> torch.Tensor | None:
+    """Per-draft-position Markov bias scales, or ``None`` for the default 1.0.
+
+    Never raises: a missing, empty, malformed or unreadable file leaves the
+    bias unscaled, so a bad sweep file can never keep the server from starting.
+    """
+    try:
+        with open(path) as f:
+            raw = f.read().strip()
+    except FileNotFoundError:
+        logger.warning("DSpark Markov scale: %s not found, using 1.0", path)
+        return None
+    except OSError:
+        logger.warning(
+            "DSpark Markov scale: cannot read %s, using 1.0", path, exc_info=True
+        )
+        return None
+    if not raw:
+        logger.warning("DSpark Markov scale: %s is empty, using 1.0", path)
+        return None
+    try:
+        values = [
+            float(part)
+            for part in raw.replace("\n", ",").split(",")
+            if part.strip()
+        ]
+    except ValueError:
+        logger.warning(
+            "DSpark Markov scale: %r is not a list of floats, using 1.0", raw
+        )
+        return None
+    if not values or not all(v == v and abs(v) != float("inf") for v in values):
+        logger.warning("DSpark Markov scale: %r has no finite values, using 1.0", raw)
+        return None
+    if len(values) < num_steps:
+        if len(values) > 1:
+            logger.warning(
+                "DSpark Markov scale: %d values for %d draft positions, "
+                "repeating the last",
+                len(values),
+                num_steps,
+            )
+        values = values + [values[-1]] * (num_steps - len(values))
+    values = values[:num_steps]
+    if all(v == 1.0 for v in values):
+        logger.warning(
+            "DSpark Markov scale: %s asks for 1.0, leaving the bias alone", path
+        )
+        return None
+    logger.warning("DSpark Markov scale: %s -> %s per draft position", path, values)
+    return torch.tensor(values, dtype=torch.float32)
+
 
 def _needs_logits_for_acceptance(speculator: "DSparkSpeculator") -> bool:
     """Whether ``acceptance_estimator`` reads full vocabulary draft logits.
@@ -194,6 +258,31 @@ class DSparkSpeculator(DFlashSpeculator):
             rank, dtype=torch.float32, device=device
         )
 
+        # Acceptance-sweep knob: a runtime scale on the Markov bias (see
+        # ``_load_markov_scale``). None means "unscaled", the historical head.
+        self._markov_scale_dev = _load_markov_scale(
+            MARKOV_SCALE_PATH, self.num_speculative_steps
+        )
+        if self._markov_scale_dev is not None:
+            self._markov_scale_dev = self._markov_scale_dev.to(device)
+
+    def _markov_bias_embed(
+        self, markov_embed: torch.Tensor, step: int
+    ) -> torch.Tensor:
+        """``markov_embed`` with this draft position's Markov scale applied.
+
+        ``bias = W2 @ embed`` is linear in the embedding, so scaling the
+        embedding scales the bias — identically for the dense projection, the
+        vocabulary-parallel one and the fused greedy kernels that never
+        materialise a bias tensor. The scaling is a separate tensor, so the
+        copy kept for the confidence head stays unscaled. Returns the
+        embedding itself when no scale is loaded (no extra copy at all).
+        """
+        if self._markov_scale_dev is None:
+            return markov_embed
+        scale = self._markov_scale_dev[step].to(markov_embed.dtype)
+        return markov_embed * scale
+
     @property
     def attn_vllm_config(self) -> VllmConfig:
         config = super().attn_vllm_config
@@ -486,8 +575,9 @@ class DSparkSpeculator(DFlashSpeculator):
