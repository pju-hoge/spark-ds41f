                 if self.draft_logits is None and not _needs_logits_for_acceptance(self):
                     draft_sampled_i = self.model.sample_local_draft_logits(
                         base_logits[:, i], bias
@@ -511,10 +601,10 @@ class DSparkSpeculator(DFlashSpeculator):
