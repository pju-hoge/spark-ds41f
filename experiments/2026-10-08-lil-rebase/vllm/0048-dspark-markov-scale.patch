                         bias[:, :shard_vocab],
@@ -549,7 +639,7 @@ class DSparkSpeculator(DFlashSpeculator):
                 )
                 prev = draft_sampled_i
                 continue
-            bias = self.model.markov_bias(markov_embed)
+            bias = self.model.markov_bias(markov_bias_embed)
             if (
                 self.draft_logits is None
                 and self.model.draft_id_to_target_id is None
@@ -629,7 +719,7 @@ class DSparkSpeculator(DFlashSpeculator):
