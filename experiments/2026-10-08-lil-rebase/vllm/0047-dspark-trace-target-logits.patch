-"""Per-step DSpark draft trace (drafts, confidences, and drafter input).
+"""Per-step DSpark draft trace (drafts, confidences, drafter input, target
+top-k logits).
 
 With ``SPARK3_DSPARK_TRACE=<path>``, TP rank 0 appends one JSON line per
 request per step: the tokens sampled this step, how many of the previous
@@ -8,13 +9,32 @@ step's drafts were verified, the drafts and raw confidences proposed for the
 next step, and a window into the drafter's input buffer (the mean-pooled
 target aux hidden states that ``main_proj`` consumes).
 
-Hidden rows are written to ``<path>.hidden.f16`` as raw little-endian fp16 and
-referenced from the JSON line by offset, so the JSONL stays readable while the
-tensor dump stays compact. Set ``SPARK3_DSPARK_TRACE_EVERY=N`` to record only
-every Nth step (default 1).
+Tensor data lives in random-access side files written in lockstep with the
+JSON lines and referenced from them by byte offset, so the JSONL stays
+readable while the dumps stay compact:
+
+* ``<path>.hidden.f16`` — the drafter's input rows (``h`` in the JSON line).
+* ``<path>.topk.f32`` and ``<path>.topk.i32`` — top-k values and vocabulary
+  ids of the *target* (backbone) logits at every verification position
+  (``l`` in the JSON line). These are the raw ``U_k`` before the Markov bias
+  is added, i.e. exactly the residual the drafter's Markov head is fitted
+  against.
+
+Hidden rows are raw little-endian fp16. Top-k values are raw little-endian
+fp32 and ids raw little-endian int32; a step writes ``rows * k`` of each, so
+the two top-k files share one byte offset. Set ``SPARK3_DSPARK_TRACE_EVERY=N``
+to record only every Nth step (default 1) and ``SPARK3_DSPARK_TRACE_TOPK`` to
+change the number of logits kept per position (default 32; 0 disables the
+logits dump). A step whose logits were never materialised (all-greedy
+verification samples straight from the vocabulary shards) records ``lx: 1``
+and no ``l``.
 
 Tracing copies GPU tensors to the host each recorded step; use it for replay
 runs only, never for timing. Off unless the variable is set.
+
+The JSONL and its side files are appended to: start a run from an empty
+directory, or delete the JSONL and its side files together, so their offsets
+stay unambiguous.
 """
 
 import json
@@ -33,13 +53,77 @@ if _TRACE_PATH is None and os.path.exists("/cache/dspark-trace/ENABLED"):
 _TRACE_EVERY = max(1, int(os.environ.get("SPARK3_DSPARK_TRACE_EVERY") or 1))
 
 
+def _topk_from_env() -> int:
+    raw = (os.environ.get("SPARK3_DSPARK_TRACE_TOPK") or "").strip()
+    if not raw:
+        return 32
+    try:
+        return max(0, int(raw))
+    except ValueError:
+        return 32
+
+
+# Logits kept per verification position. Zero disables the logits dump.
+_TRACE_TOPK = _topk_from_env()
+# The runner's hot path checks this single bool: with tracing off, no extra
+# work and no extra copy of any kind happens.
+LOGITS_ENABLED = _TRACE_PATH is not None and _TRACE_TOPK > 0
+
+
+def capture_logits(logits: torch.Tensor) -> tuple[torch.Tensor, torch.Tensor] | None:
+    """The top-k ``(values, indices)`` of the target logits, kept on the GPU.
+
+    ``topk`` allocates its own outputs and leaves ``logits`` untouched, so the
+    sampler sees bit-for-bit the tensor it would see without tracing. The host
+    copy happens later, in ``DSparkTrace.record``. Returns ``None`` when the
+    logits dump is off.
+    """
+    if not LOGITS_ENABLED:
+        return None
+    k = min(_TRACE_TOPK, int(logits.shape[-1]))
+    return torch.topk(logits.detach(), k, dim=-1)
+
+
+def _row_ranges(
+    cu_num_logits: list[int] | None, num_reqs: int, rows: int
+) -> list[tuple[int, int]] | None:
+    """``(start row, row count)`` per request, or ``None`` when the split the
+    runner passed does not describe exactly ``rows`` logits rows."""
+    if cu_num_logits is None or len(cu_num_logits) < num_reqs + 1:
+        return None
+    if int(cu_num_logits[0]) != 0 or int(cu_num_logits[num_reqs]) != rows:
+        return None
+    ranges = []
+    for i in range(num_reqs):
+        start, end = int(cu_num_logits[i]), int(cu_num_logits[i + 1])
+        if end < start:
+            return None
+        ranges.append((start, end - start))
+    return ranges
+
+
 class DSparkTrace:
     def __init__(self, path: str) -> None:
         self._file = open(path, "a", buffering=1 << 20)  # noqa: SIM115
         self._hidden = open(path + ".hidden.f16", "ab", buffering=1 << 20)  # noqa: SIM115
         self._offset = 0
+        self._topk_values = None
+        self._topk_index = None
+        self._topk_offset = 0
+        if LOGITS_ENABLED:
+            self._topk_values = open(  # noqa: SIM115
+                path + ".topk.f32", "ab", buffering=1 << 20
+            )
+            self._topk_index = open(  # noqa: SIM115
+                path + ".topk.i32", "ab", buffering=1 << 20
+            )
         self._step = 0
 
+    @property
+    def next_step_taken(self) -> bool:
+        """Whether the step about to run is one ``record`` will keep."""
+        return self._step % _TRACE_EVERY == 0
+
     def record(
         self,
         req_ids: list[str],
@@ -50,8 +134,10 @@ class DSparkTrace:
         confidences: torch.Tensor | None,
         hidden_states: torch.Tensor | None = None,
         num_tokens: int | None = None,
+        logits_topk: tuple[torch.Tensor, torch.Tensor] | None = None,
+        logits_cu: list[int] | None = None,
     ) -> None:
-        take = self._step % _TRACE_EVERY == 0
+        take = self.next_step_taken
         self._step += 1
         if not take:
             return
@@ -81,6 +167,23 @@ class DSparkTrace:
             }
             self._offset += len(raw)
 
+        # Target top-k: one block per recorded step, each request's JSON line
+        # pointing at its own slice of it.
+        topk_block = None
+        topk_ranges = None
+        topk_k = 0
+        if logits_topk is not None and self._topk_values is not None:
+            values, index = logits_topk
+            rows = int(values.shape[0])
+            topk_k = int(values.shape[1])
+            raw_v = values.to("cpu", torch.float32).contiguous().numpy().tobytes()
+            raw_i = index.to("cpu", torch.int32).contiguous().numpy().tobytes()
+            self._topk_values.write(raw_v)
+            self._topk_index.write(raw_i)
+            topk_block = {"off": self._topk_offset, "rows": rows, "k": topk_k}
+            topk_ranges = _row_ranges(logits_cu, num_reqs, rows)
+            self._topk_offset += len(raw_v)
+
         common = {"t": self._step - 1, "b": num_reqs}
         if hidden_ref is not None:
             common["h"] = hidden_ref
@@ -93,11 +196,29 @@ class DSparkTrace:
                 record["v"] = verified[i]
             if confs is not None:
                 record["c"] = [round(c, 5) for c in confs[i]]
+            if topk_block is not None:
+                if topk_ranges is not None:
+                    start, count = topk_ranges[i]
+                    record["l"] = {
+                        "off": topk_block["off"] + start * topk_k * 4,
+                        "rows": count,
+                        "k": topk_k,
+                    }
+                elif i == 0:
+                    # Unknown per-request split: hand out the whole block.
+                    record["l"] = dict(topk_block)
+            elif LOGITS_ENABLED:
+                # The step had no full-vocabulary logits (greedy verification
+                # samples from the vocabulary shards directly).
+                record["lx"] = 1
             self._file.write(json.dumps(record, separators=(",", ":")) + "\n")
 
         if self._step % 256 == 0:
             self._file.flush()
             self._hidden.flush()
+            if self._topk_values is not None:
+                self._topk_values.flush()
+                self._topk_index.flush()
 
 
