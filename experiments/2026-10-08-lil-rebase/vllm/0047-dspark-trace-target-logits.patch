+    def _capture_dspark_trace_logits(
+        self, logits: torch.Tensor, input_batch: InputBatch
+    ) -> None:
+        """Keep this step's target top-k for the DSpark draft trace.
+
+        A no-op unless a trace is open. ``logits`` is never copied or modified:
+        the top-k allocates its own small tensor and the sampler keeps the full
+        logits, so tracing cannot change what is sampled. All-greedy steps
+        never reach here (they sample from the vocabulary shards), and
+        ``sample_tokens`` clears the capture each step, so a block from one step
+        is never recorded against another.
+        """
+        trace = getattr(self, "_dspark_trace", None)
+        if trace is None:
+            return
+        self._dspark_logits_topk = None
+        if not trace.next_step_taken:
+            return
+        topk = dspark_trace.capture_logits(logits)
+        if topk is None:
+            return
+        num_reqs = input_batch.num_reqs
+        self._dspark_logits_topk = (
+            topk,
+            [int(x) for x in input_batch.cu_num_logits_np[: num_reqs + 1]],
+        )
+
